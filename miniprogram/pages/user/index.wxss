/**index.wxss**/

page {
  padding-top: 54rpx;
  background-color: #f6f6f6;
  padding-bottom: 60rpx;
}

.container {
  font-family: PingFang SC;
}

.header {
  display: flex;
  align-items: center;
  width: 93%;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.header .avatar-button {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 50%;
}

.avatar,
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 44rpx;
  background-color: #07c160;
}

.profile-content {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.greeting {
  overflow: hidden;
  color: #191919;
  font-size: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname-input {
  margin-top: 12rpx;
  color: #777777;
  font-size: 26rpx;
}

.profile-button {
  flex: none;
  margin-left: 16rpx;
  padding: 12rpx 16rpx;
  color: #07c160;
  font-size: 24rpx;
  border: 1rpx solid #07c160;
  border-radius: 28rpx;
}

.account-summary {
  width: 93%;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.8;
  background-color: #ffffff;
}

.operate{
  margin-top: 30rpx;
  border-radius: 5px;
  background-color: white;
  width: 93%;
  padding-bottom: 1rpx;
}
